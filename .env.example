PORT=3000

# Option 1 (default): PEM files. `npm run keys:generate` creates them.
RSA_PRIVATE_KEY_PATH=keys/private.pem
RSA_PUBLIC_KEY_PATH=keys/public.pem

# Option 2: inline PEM, which takes priority over the paths above.
# Use \n for line breaks, e.g. RSA_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----"
# RSA_PRIVATE_KEY=
# RSA_PUBLIC_KEY=
